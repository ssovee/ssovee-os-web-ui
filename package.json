{
  "name": "ssovee-os-web-ui",
  "version": "0.1.6",
  "description": "Reusable UI component library for shared applications.",
  "author": "SSOVEE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssovee/ssovee-os-web-ui.git"
  },
  "homepage": "https://github.com/ssovee/ssovee-os-web-ui#readme",
  "keywords": [
    "react",
    "ui",
    "components",
    "library",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tailwind-preset.js",
    "theme.css"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "publish:ci": "npm publish --access public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.4 <5"
  },
  "dependencies": {
    "@phosphor-icons/react": ">=2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.3.3",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
