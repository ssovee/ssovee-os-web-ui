{
  "name": "ssovee-os-web-ui",
  "version": "0.1.12",
  "description": "Reusable UI component library for shared applications.",
  "author": "SSOVEE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssovee/ssovee-os-web-ui.git"
  },
  "homepage": "https://github.com/ssovee/ssovee-os-web-ui#readme",
  "keywords": [
    "react",
    "ui",
    "components",
    "library",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./tailwind.config.js": "./tailwind.config.js",
    "./theme.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tailwind-preset.js",
    "tailwind.config.js"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i ./src/theme.css -o ./dist/index.css",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "publish:ci": "npm publish --access public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@phosphor-icons/react": ">=2",
    "tailwindcss": ">=3.4 <5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
